# EditorConfig is awesome: https://editorconfig.org

# Standardkonfiguration
root = true

# Alle Dateien
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.sh]
ident_size = 2
trim_trailing_whitespace = true

# Spezielle Konfiguration für Makefiles (einschließlich debian/rules)
[Makefile]
indent_style = tab

[debian/rules]
indent_style = tab

# Markdown-Dateien
[*.{md,markdown}]
trim_trailing_whitespace = false